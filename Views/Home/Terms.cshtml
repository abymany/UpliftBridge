@{
    ViewData["Title"] = "Terms of Use";
}

<section class="container py-5" style="max-width:900px;">

    <div class="mb-5">
        <span class="text-uppercase text-muted fw-bold">
            UpliftBridge
        </span>

        <h1 class="display-5 mt-2">
            Terms of Use
        </h1>

        <p class="text-muted">
            Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")
        </p>
    </div>

    <div class="mb-5">

        <h3>1. Platform purpose</h3>

        <p>
            UpliftBridge is a community platform that helps people discover,
            verify and support educational, personal and community needs.
        </p>

        <p>
            UpliftBridge exists to connect people who wish to help with people
            requesting support.
        </p>

    </div>

    <div class="mb-5">

        <h3>2. Donation handling</h3>

        <p>
            UpliftBridge does not collect, hold, distribute or manage donations
            intended for listed needs.
        </p>

        <p>
            Donations for needs are completed directly with schools,
            organizations, vendors, institutions or external payment pages
            where applicable.
        </p>

        <p>
            UpliftBridge may collect optional platform support payments
            required for hosting, moderation, verification and operational costs.
        </p>

    </div>

    <div class="mb-5">

        <h3>3. Verification</h3>

        <p>
            UpliftBridge may review submissions manually and request documents,
            proof or clarification before publishing a need.
        </p>

        <p>
            Publication does not guarantee authenticity, eligibility or future
            outcomes.
        </p>

    </div>

    <div class="mb-5">

        <h3>4. User responsibilities</h3>

        <ul>

            <li>
                Provide truthful information
            </li>

            <li>
                Avoid fraudulent submissions
            </li>

            <li>
                Respect other users
            </li>

            <li>
                Use external payment links responsibly
            </li>

        </ul>

    </div>

    <div class="mb-5">

        <h3>5. Content removal</h3>

        <p>
            UpliftBridge reserves the right to remove content,
            suspend listings or reject submissions at its discretion.
        </p>

    </div>

    <div class="alert alert-light border">

        UpliftBridge facilitates discovery and verification of needs.

        Need donations are completed directly with external organizations,
        schools, vendors or official payees where applicable.

    </div>

</section>