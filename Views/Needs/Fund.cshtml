@model UpliftBridge.Models.FundNeedViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Give a Gift";

    var remaining = Model.RemainingAmount;
    var hasRemaining = remaining > 0;
    var finishAmt = hasRemaining ? remaining : 0m;
    var halfRemaining = hasRemaining ? Math.Max(50m, Math.Round(remaining / 2m, 0)) : 0m;
}

@section Styles {
<style>
    .fund-shell {
        padding: 3.5rem 0 4rem;
        background: linear-gradient(180deg, rgba(37,99,235,.06), rgba(255,255,255,0));
    }

    .fund-card {
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(15,23,42,.10);
        padding: 28px;
    }

    .fund-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: #0f172a;
        margin-bottom: .5rem;
    }

    .muted {
        color: #64748b;
        font-weight: 650;
    }

    .amount-chip {
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 9px 14px;
        background: #fff;
        font-weight: 900;
        cursor: pointer;
        margin: 0 6px 8px 0;
    }

    .amount-chip:hover {
        background: #f8fafc;
    }

    .summary-box {
        border: 1px solid #eef2f7;
        background: #f8fafc;
        border-radius: 18px;
        padding: 14px;
        margin-top: 14px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 8px;
        font-weight: 800;
    }

    .summary-row:last-child {
        margin-bottom: 0;
        font-size: 1.05rem;
        color: #0f172a;
    }

    .cta {
        border-radius: 999px;
        padding: 13px 18px;
        font-weight: 950;
        font-size: 1.05rem;
    }
</style>
}

<div class="fund-shell">
    <div class="container">
        <div class="row justify-content-center g-4">
            <div class="col-lg-5">
                <div class="fund-card">
                    <div class="text-uppercase muted" style="letter-spacing:.14em;font-size:.78rem;">
                        Give securely
                    </div>

                    <h1 class="fund-title">Support this need</h1>

                    <p class="muted mb-2">You’re supporting:</p>
                    <h2 class="h5 fw-bold mb-3">@Model.Title</h2>

                    <div class="summary-box">
                        <div class="summary-row">
                            <span>Goal</span>
                            <span>@Model.GoalAmount.ToString("C0")</span>
                        </div>
                        <div class="summary-row">
                            <span>Raised</span>
                            <span>@Model.AmountRaised.ToString("C0")</span>
                        </div>
                        <div class="summary-row">
                            <span>Still needed</span>
                            <span>@Model.RemainingAmount.ToString("C0")</span>
                        </div>
                    </div>

                    <p class="muted mt-3 mb-0">
                        Your gift is processed securely through Stripe. UpliftBridge records the gift and platform support separately.
                    </p>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="fund-card">
                    @if (Model.IsFullyFunded)
                    {
                        <h2 class="h4 fw-bold">This need is fully funded</h2>
                        <p class="muted">Thank you for checking. This need no longer needs additional gifts.</p>

                        <a class="btn btn-outline-dark rounded-pill fw-bold"
                           asp-controller="Needs"
                           asp-action="Details"
                           asp-route-id="@Model.NeedId">
                            Back to need
                        </a>
                    }
                    else
                    {
                        <h2 class="h4 fw-bold mb-2">Choose an amount</h2>
                        <p class="muted">Pick an amount or enter your own.</p>

                        <div class="mb-3">
                            @if (finishAmt >= 50)
                            {
                                <button type="button" class="amount-chip" data-amt="@finishAmt.ToString(CultureInfo.InvariantCulture)">
                                    Cover remaining (@finishAmt.ToString("C0"))
                                </button>
                            }

                            @if (halfRemaining >= 50)
                            {
                                <button type="button" class="amount-chip" data-amt="@halfRemaining.ToString(CultureInfo.InvariantCulture)">
                                    Half (@halfRemaining.ToString("C0"))
                                </button>
                            }

                            <button type="button" class="amount-chip" data-amt="50">$50</button>
                            <button type="button" class="amount-chip" data-amt="100">$100</button>
                            <button type="button" class="amount-chip" data-amt="250">$250</button>
                        </div>

                        <form asp-controller="Needs" asp-action="CreateCheckout" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="NeedId" />
                            <input type="hidden" asp-for="Title" />
                            <input type="hidden" asp-for="GoalAmount" />
                            <input type="hidden" asp-for="AmountRaised" />

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="DonorName" class="form-label fw-bold">Name</label>
                                    <input asp-for="DonorName" class="form-control" placeholder="Optional" />
                                    <span asp-validation-for="DonorName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="DonorEmail" class="form-label fw-bold">Email</label>
                                    <input asp-for="DonorEmail" class="form-control" placeholder="Optional" />
                                    <span asp-validation-for="DonorEmail" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="IsAnonymous" class="form-check-input" />
                                <label asp-for="IsAnonymous" class="form-check-label fw-semibold">
                                    Give anonymously
                                </label>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ItemCost" class="form-label fw-bold">Gift amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ItemCost"
                                           id="giftAmount"
                                           class="form-control"
                                           type="number"
                                           min="50"
                                           step="0.01"
                                           value="50" />
                                </div>
                                <span asp-validation-for="ItemCost" class="text-danger small"></span>
                                <div class="muted mt-1" style="font-size:.9rem;">Minimum gift is $50.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TipPercent" class="form-label fw-bold">Platform support</label>
                                <select asp-for="TipPercent" id="tipPercent" class="form-select">
                                    <option value="1">1%</option>
                                    <option value="2">2%</option>
                                    <option value="5">5%</option>
                                    <option value="10">10%</option>
                                </select>
                                <div class="muted mt-1" style="font-size:.9rem;">
                                    This helps cover hosting, verification, moderation, and operations.
                                </div>
                            </div>

                            <div class="summary-box">
                                <div class="summary-row">
                                    <span>Gift amount</span>
                                    <span id="giftDisplay">$50.00</span>
                                </div>
                                <div class="summary-row">
                                    <span>Platform support</span>
                                    <span id="feeDisplay">$0.50</span>
                                </div>
                                <div class="summary-row">
                                    <span>Charged today</span>
                                    <span id="totalDisplay">$0.50</span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 cta mt-3">
                                Continue to Secure Checkout
                            </button>

                            <p class="muted mt-3 mb-0" style="font-size:.9rem;">
                                Payment is handled by Stripe. UpliftBridge does not store card details.
                            </p>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const giftInput = document.getElementById("giftAmount");
            const tipSelect = document.getElementById("tipPercent");
            const giftDisplay = document.getElementById("giftDisplay");
            const feeDisplay = document.getElementById("feeDisplay");
            const totalDisplay = document.getElementById("totalDisplay");
            const chips = document.querySelectorAll(".amount-chip");

            function money(v) {
                if (isNaN(v)) return "$0.00";
                return "$" + v.toFixed(2);
            }

            function update() {
                const gift = parseFloat(giftInput?.value || "0");
                const pct = parseFloat(tipSelect?.value || "1");

                let fee = gift * (pct / 100);
                fee = Math.round(fee * 100) / 100;

                if (fee > 0 && fee < 0.50) fee = 0.50;

                giftDisplay.textContent = money(gift);
                feeDisplay.textContent = money(fee);
                totalDisplay.textContent = money(fee);
            }

            chips.forEach(btn => {
                btn.addEventListener("click", function () {
                    const amt = parseFloat(btn.getAttribute("data-amt"));
                    if (!isNaN(amt)) {
                        giftInput.value = amt.toFixed(2);
                        update();
                    }
                });
            });

            giftInput?.addEventListener("input", update);
            tipSelect?.addEventListener("change", update);

            update();
        })();
    </script>
}