@model UpliftBridge.Models.NeedCreateViewModel
@using UpliftBridge.Models

@{
    ViewData["Title"] = "Post a Need";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "needs-create-page";
}

@section Styles {
<style>
  .kg-section-label{
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: .8rem;
    font-weight: 850;
    color: rgba(15,23,42,.72);
  }
  .kg-page-title{
    font-family: "Playfair Display", serif;
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1.12;
    color: #0b1220;
    margin-bottom: .85rem;
  }
  .kg-page-lead{
    font-size: 1rem;
    color: rgba(15,23,42,.78);
    max-width: 720px;
    font-weight: 650;
  }
  .kg-card{
    border-radius: 24px;
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(15,23,42,0.08);
    box-shadow: 0 18px 50px rgba(15,23,42,0.10);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }
  .kg-card-soft{
    border-radius: 24px;
    background: rgba(255,255,255,0.92);
    border: 1px solid rgba(15,23,42,0.07);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 12px 36px rgba(15,23,42,0.10);
  }
  .form-label{
    font-weight: 850;
    color: #0b1220;
  }
  .form-text{
    font-size: .88rem;
    color: rgba(15,23,42,.60);
    font-weight: 650;
  }
  .text-danger{
    font-weight: 700;
  }
  .kg-pill{
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: .35rem .85rem;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .10em;
    text-transform: uppercase;
    background: rgba(200,169,106,.14);
    color: rgba(90,64,22,.92);
    border: 1px solid rgba(200,169,106,.35);
  }
  .kg-list-check{
    list-style: none;
    padding-left: 0;
    margin-bottom: 0;
  }
  .kg-list-check li{
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: .65rem;
    font-size: .95rem;
    color: rgba(15,23,42,.78);
    font-weight: 700;
  }
  .kg-list-check li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: #16a34a;
    font-weight: 900;
  }
  .kg-note{
    font-size: .85rem;
    color: rgba(15,23,42,.58);
    font-weight: 650;
  }
  .kg-consent-box{
    border-radius: 18px;
    background: rgba(15,23,42,0.04);
    border: 1px solid rgba(15,23,42,0.06);
    padding: 1rem 1.25rem;
    font-size: .9rem;
    color: rgba(15,23,42,.72);
    font-weight: 650;
  }
  .kg-badge-soft{
    padding: .25rem .75rem;
    border-radius: 999px;
    font-size: .76rem;
    background: rgba(200,169,106,.16);
    color: rgba(90,64,22,.92);
    font-weight: 900;
    border: 1px solid rgba(200,169,106,.28);
  }
  .kg-chip-row{
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: .35rem;
  }
  .kg-chip{
    font-size: .78rem;
    padding: .22rem .65rem;
    border-radius: 999px;
    background: rgba(15,23,42,0.05);
    border: 1px solid rgba(15,23,42,0.06);
    color: rgba(15,23,42,.72);
    font-weight: 800;
  }
  .kg-submit{
    border-radius: 999px;
    padding: .95rem 1.25rem;
    font-weight: 950;
    border: 1px solid rgba(200,169,106,.55);
    background: linear-gradient(180deg, #e6d3a2, #c8a96a);
    color: #1b140a;
    box-shadow: 0 18px 44px rgba(0,0,0,.18);
  }
  .kg-submit:hover{
    filter: brightness(1.05);
    transform: translateY(-1px);
  }
  .kg-location-wrap{
    position: relative;
  }
  .kg-location-dropdown{
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 50;
    background: #fff;
    border: 1px solid rgba(15,23,42,0.10);
    border-radius: 16px;
    box-shadow: 0 18px 40px rgba(15,23,42,0.14);
    max-height: 260px;
    overflow-y: auto;
    padding: .35rem;
  }
  .kg-location-option{
    padding: .75rem .9rem;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 700;
    color: rgba(15,23,42,.86);
    transition: background .15s ease;
  }
  .kg-location-option:hover,
  .kg-location-option.active{
    background: rgba(15,23,42,0.06);
  }
  .kg-location-empty{
    padding: .75rem .9rem;
    color: rgba(15,23,42,.55);
    font-weight: 650;
  }
  .kg-currency-chip{
    display: inline-flex;
    align-items: center;
    padding: .2rem .65rem;
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 900;
    background: rgba(15,23,42,0.05);
    border: 1px solid rgba(15,23,42,0.08);
    color: rgba(15,23,42,.78);
  }
  .d-none{
    display: none !important;
  }
</style>
}

<div class="py-5">
  <div class="container">

    <div class="row mb-4">
      <div class="col-lg-9">
        <div class="kg-section-label mb-2">Post a need</div>
        <h1 class="kg-page-title">Tell the world what one quiet gift could change.</h1>

        <p class="kg-page-lead">
          Share a clear, honest story. Explain what is needed, why it matters, and what support would actually solve.
        </p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-7 mb-4">

        <form asp-action="Create" method="post" enctype="multipart/form-data">
          @Html.AntiForgeryToken()

          <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">About this need</h2>

            <div class="mb-3">
              <label class="form-label" asp-for="Title"></label>
              <input class="form-control" asp-for="Title" />
              <span class="text-danger" asp-validation-for="Title"></span>
            </div>

            <div class="mb-3">
              <label class="form-label" asp-for="ForWhom"></label>
              <input class="form-control" asp-for="ForWhom" />
              <span class="text-danger" asp-validation-for="ForWhom"></span>
              <div class="form-text">Use first name and relationship only. Avoid full legal names.</div>
            </div>

            <div class="mb-3">
              <label class="form-label" asp-for="AgeRange"></label>
              <select class="form-select" asp-for="AgeRange">
                <option value="">Choose one</option>
                <option>Child (under 13)</option>
                <option>Teen (13–17)</option>
                <option>Young adult (18–25)</option>
                <option>Adult (26+)</option>
              </select>
              <span class="text-danger" asp-validation-for="AgeRange"></span>
            </div>

            <div class="mb-3">
              <label class="form-label" asp-for="Story"></label>
              <textarea class="form-control" asp-for="Story" rows="5"></textarea>
              <span class="text-danger" asp-validation-for="Story"></span>
            </div>

            <div class="mb-3">
              <label class="form-label" asp-for="LongTermDream"></label>
              <textarea class="form-control" asp-for="LongTermDream" rows="3"></textarea>
              <span class="text-danger" asp-validation-for="LongTermDream"></span>
            </div>

            <div class="mb-0">
              <label class="form-label" asp-for="TriedAlready"></label>
              <textarea class="form-control" asp-for="TriedAlready" rows="3"></textarea>
              <span class="text-danger" asp-validation-for="TriedAlready"></span>
            </div>
          </div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">Type of need & location</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" asp-for="Category"></label>
                <select class="form-select" asp-for="Category" asp-items="Html.GetEnumSelectList<NeedCategory>()"></select>
                <span class="text-danger" asp-validation-for="Category"></span>
              </div>

              <div class="col-md-6">
                <label class="form-label" asp-for="CityCountry"></label>

                <div class="kg-location-wrap">
                  <input
                    class="form-control"
                    id="locationInput"
                    asp-for="CityCountry"
                    placeholder="Start typing city or country..."
                    autocomplete="off" />
                  <div id="locationDropdown" class="kg-location-dropdown d-none"></div>
                </div>

                <span class="text-danger" asp-validation-for="CityCountry"></span>
                <div class="form-text">Publicly shown to donors as city and country only.</div>
              </div>
            </div>

            <hr class="my-4" />

            <h6 class="mb-2" style="font-weight:900;">What exactly are you requesting?</h6>

            <div class="mb-2">
              <label class="form-label small">Item 1 <span class="text-danger">*</span></label>
              <div class="row g-2">
                <div class="col-md-5">
                  <input class="form-control" asp-for="Items[0].Name" placeholder="Item name" />
                  <span class="text-danger" asp-validation-for="Items[0].Name"></span>
                </div>
                <div class="col-md-3">
                  <input class="form-control" asp-for="Items[0].Cost" placeholder="Estimated cost" />
                  <span class="text-danger" asp-validation-for="Items[0].Cost"></span>
                </div>
                <div class="col-md-4">
                  <input class="form-control" asp-for="Items[0].Link" placeholder="Link (optional)" />
                  <span class="text-danger" asp-validation-for="Items[0].Link"></span>
                </div>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label small">Item 2 (optional)</label>
              <div class="row g-2">
                <div class="col-md-5">
                  <input class="form-control kg-optional-item" asp-for="Items[1].Name" placeholder="Item name" />
                  <span class="text-danger" asp-validation-for="Items[1].Name"></span>
                </div>
                <div class="col-md-3">
                  <input class="form-control kg-optional-item" asp-for="Items[1].Cost" placeholder="Estimated cost" />
                  <span class="text-danger" asp-validation-for="Items[1].Cost"></span>
                </div>
                <div class="col-md-4">
                  <input class="form-control kg-optional-item" asp-for="Items[1].Link" placeholder="Link (optional)" />
                  <span class="text-danger" asp-validation-for="Items[1].Link"></span>
                </div>
              </div>
            </div>

            <div class="mb-0">
              <label class="form-label small">Item 3 (optional)</label>
              <div class="row g-2">
                <div class="col-md-5">
                  <input class="form-control kg-optional-item" asp-for="Items[2].Name" placeholder="Item name" />
                  <span class="text-danger" asp-validation-for="Items[2].Name"></span>
                </div>
                <div class="col-md-3">
                  <input class="form-control kg-optional-item" asp-for="Items[2].Cost" placeholder="Estimated cost" />
                  <span class="text-danger" asp-validation-for="Items[2].Cost"></span>
                </div>
                <div class="col-md-4">
                  <input class="form-control kg-optional-item" asp-for="Items[2].Link" placeholder="Link (optional)" />
                  <span class="text-danger" asp-validation-for="Items[2].Link"></span>
                </div>
              </div>
            </div>
          </div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">Money, timing & urgency</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="goalAmount">Goal amount</label>
                <input
                  type="text"
                  class="form-control"
                  id="goalAmount"
                  name="GoalAmount"
                  value="@(Model != null && Model.GoalAmount > 0 ? Model.GoalAmount.ToString("0.##") : "")"
                  placeholder="Enter amount"
                  inputmode="decimal"
                  autocomplete="off" />
                <span class="text-danger" asp-validation-for="GoalAmount"></span>
                <div class="form-text d-flex align-items-center justify-content-between gap-2">
                  <span>Enter only numbers. Example: 250 or 250.50</span>
                  <span class="kg-currency-chip" id="currencyHint">USD</span>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label" asp-for="Deadline"></label>
                <input type="date" class="form-control" asp-for="Deadline" />
                <span class="text-danger" asp-validation-for="Deadline"></span>
              </div>
            </div>

            <div class="mt-3">
              <label class="form-label" asp-for="Urgency"></label>
              <select class="form-select" asp-for="Urgency">
                <option value="">Choose one</option>
                <option value="NoDeadline">No deadline, any time helps</option>
                <option value="Month">Needed within a month</option>
                <option value="TwoWeeks">Needed within two weeks</option>
                <option value="Emergency">Emergency</option>
              </select>
              <span class="text-danger" asp-validation-for="Urgency"></span>
            </div>
          </div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">Verification</h2>

            <div class="kg-consent-box">
              <strong>Verification happens after submission.</strong>
              <p class="kg-note mt-1 mb-0">
                UpliftBridge assigns verification levels after review.
              </p>
            </div>

            <div class="mb-3 mt-3">
              <label class="form-label" asp-for="VerificationNote"></label>
              <input class="form-control" asp-for="VerificationNote" />
              <span class="text-danger" asp-validation-for="VerificationNote"></span>
            </div>

            <hr class="my-4" />

            <h6 class="mb-2" style="font-weight:900;">Institution verification (optional)</h6>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" asp-for="InstitutionType"></label>
                <select class="form-select" asp-for="InstitutionType">
                  <option value="">Choose one</option>
                  <option>School</option>
                  <option>College</option>
                  <option>University</option>
                  <option>Hospital</option>
                  <option>Clinic</option>
                  <option>Nonprofit</option>
                  <option>Community center</option>
                  <option>Sports club</option>
                  <option>Store / vendor</option>
                  <option>Other</option>
                </select>
                <span class="text-danger" asp-validation-for="InstitutionType"></span>
              </div>

              <div class="col-md-6">
                <label class="form-label" asp-for="InstitutionName"></label>
                <input class="form-control" asp-for="InstitutionName" />
                <span class="text-danger" asp-validation-for="InstitutionName"></span>
              </div>
            </div>

            <div class="mt-3">
              <label class="form-label" asp-for="InstitutionFullAddress"></label>
              <textarea
                class="form-control"
                asp-for="InstitutionFullAddress"
                rows="3"
                placeholder="Street address, suite/unit, city, state/province, postal code, country"></textarea>
              <div class="form-text">Used for verification only. This will not be shown publicly to donors.</div>
              <span class="text-danger" asp-validation-for="InstitutionFullAddress"></span>
            </div>

            <div class="form-check mt-3">
              <input class="form-check-input" asp-for="PreferDirectToInstitution" id="directPayToggle" />
              <label class="form-check-label" for="directPayToggle">
                Prefer donors to pay the institution directly
              </label>
            </div>

            <div class="mt-3" id="payLinkWrap">
              <label class="form-label" asp-for="InstitutionPaymentLink"></label>
              <input class="form-control" asp-for="InstitutionPaymentLink" id="institutionPaymentLinkInput" />
              <div class="form-text">Only use an official institution payment link.</div>
              <span class="text-danger" asp-validation-for="InstitutionPaymentLink"></span>
            </div>

            <hr class="my-4" />

            <div class="mb-0">
              <label class="form-label" asp-for="PayTo"></label>
              <input class="form-control" asp-for="PayTo" />
              <div class="form-text">Shown publicly as “Pay to”. Keep it short.</div>
              <span class="text-danger" asp-validation-for="PayTo"></span>
            </div>
          </div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">Contact for follow-up (private)</h2>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" asp-for="ContactEmail"></label>
                <input class="form-control" asp-for="ContactEmail" />
                <span class="text-danger" asp-validation-for="ContactEmail"></span>
              </div>
              <div class="col-md-6">
                <label class="form-label" asp-for="ContactPhone"></label>
                <input class="form-control" asp-for="ContactPhone" />
                <span class="text-danger" asp-validation-for="ContactPhone"></span>
              </div>
            </div>
          </div>

          <div class="kg-card">
            <h2 class="h5 mb-3" style="font-weight:900;">Photos (optional)</h2>

            <label class="form-label" asp-for="Photos">Upload photos (up to 6)</label>
            <input asp-for="Photos" type="file" class="form-control" multiple accept="image/*" />
            <span class="text-danger d-block mt-1" asp-validation-for="Photos"></span>
            <div class="form-text">JPG, PNG, or WEBP. Leave empty if you do not want to upload photos.</div>
          </div>

          <div class="kg-card">
            <div class="kg-consent-box mb-3">
              <div class="form-check mb-2">
                <input class="form-check-input" asp-for="HonestyPledge" />
                <label class="form-check-label" asp-for="HonestyPledge">
                  I confirm that everything shared here is true and respectful.
                </label>
              </div>
              <span class="text-danger" asp-validation-for="HonestyPledge"></span>
            </div>

            <button type="submit" class="kg-submit w-100">Submit this need for review</button>
            <p class="kg-note mt-3 mb-0">Clear, specific, honest requests get approved faster.</p>
          </div>
        </form>
      </div>

      <div class="col-lg-5 mb-4">
        <div class="kg-card-soft mb-4">
          <div class="kg-pill mb-3">What helps donors trust</div>
          <h3 class="h5 mb-3" style="font-weight:900;">Make it specific</h3>
          <ul class="kg-list-check">
            <li>Say what is needed.</li>
            <li>Explain why it matters.</li>
            <li>Show what you already tried.</li>
            <li>List exact items and costs.</li>
            <li>Keep the story honest and calm.</li>
          </ul>
        </div>

        <div class="kg-card-soft mb-4" style="background:linear-gradient(135deg, rgba(224,242,254,.9), rgba(254,243,199,.9));">
          <div class="kg-pill mb-3">How we protect trust</div>
          <ul class="kg-list-check">
            <li>We review every submission.</li>
            <li>We reject unclear or unsafe requests.</li>
            <li>We prefer verifiable, item-based needs.</li>
          </ul>
        </div>

        <div class="kg-card-soft">
          <span class="kg-badge-soft mb-2 d-inline-block">Why this matters</span>
          <p class="mt-2" style="font-size:.95rem; color:rgba(15,23,42,.78); font-weight:700;">
            One practical gift can change a school term, a season, or a future.
          </p>
          <div class="kg-chip-row">
            <span class="kg-chip">Dignity</span>
            <span class="kg-chip">Honesty</span>
            <span class="kg-chip">Clarity</span>
            <span class="kg-chip">Future</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const directPayToggle = document.getElementById("directPayToggle");
        const payLinkWrap = document.getElementById("payLinkWrap");
        const institutionPaymentLinkInput = document.getElementById("institutionPaymentLinkInput");

        if (directPayToggle && payLinkWrap && institutionPaymentLinkInput) {
            function syncPayLink() {
                const enabled = directPayToggle.checked;
                payLinkWrap.style.display = enabled ? "" : "none";
                institutionPaymentLinkInput.disabled = !enabled;
                if (!enabled) institutionPaymentLinkInput.value = "";
            }

            directPayToggle.addEventListener("change", syncPayLink);
            syncPayLink();
        }

        const trash = new Set(["na", "n/a", "none", "-", "--", "null", "0"]);
        document.querySelectorAll(".kg-optional-item").forEach(el => {
            el.addEventListener("blur", () => {
                const v = (el.value || "").trim().toLowerCase();
                if (trash.has(v)) el.value = "";
            });
        });

        const countryCurrencyMap = {
            "United States": "USD",
            "India": "INR",
            "Canada": "CAD",
            "United Kingdom": "GBP",
            "Australia": "AUD",
            "Pakistan": "PKR",
            "Kenya": "KES",
            "Nigeria": "NGN",
            "South Africa": "ZAR",
            "Bangladesh": "BDT",
            "Nepal": "NPR",
            "Sri Lanka": "LKR",
            "Philippines": "PHP",
            "UAE": "AED",
            "Saudi Arabia": "SAR",
            "Germany": "EUR",
            "France": "EUR",
            "Italy": "EUR"
        };

        const locationInput = document.getElementById("locationInput");
        const locationDropdown = document.getElementById("locationDropdown");
        const currencyHint = document.getElementById("currencyHint");

        let locationTimer = null;
        let activeIndex = -1;
        let currentOptions = [];

        function setCurrencyHint(val) {
            let currency = "USD";
            Object.keys(countryCurrencyMap).forEach(country => {
                if ((val || "").toLowerCase().includes(country.toLowerCase())) {
                    currency = countryCurrencyMap[country];
                }
            });
            if (currencyHint) {
                currencyHint.textContent = currency;
            }
        }

        function hideLocationDropdown() {
            if (!locationDropdown) return;
            locationDropdown.classList.add("d-none");
            locationDropdown.innerHTML = "";
            currentOptions = [];
            activeIndex = -1;
        }

        function renderLocationOptions(items) {
            if (!locationDropdown) return;

            currentOptions = items || [];
            activeIndex = -1;
            locationDropdown.innerHTML = "";

            if (!currentOptions.length) {
                locationDropdown.innerHTML = '<div class="kg-location-empty">No matching cities found.</div>';
                locationDropdown.classList.remove("d-none");
                return;
            }

            currentOptions.forEach((item, index) => {
                const option = document.createElement("div");
                option.className = "kg-location-option";
                option.textContent = item;
                option.dataset.index = index;

                option.addEventListener("mousedown", function (e) {
                    e.preventDefault();
                    locationInput.value = item;
                    setCurrencyHint(item);
                    hideLocationDropdown();
                });

                locationDropdown.appendChild(option);
            });

            locationDropdown.classList.remove("d-none");
        }

        function updateActiveOption() {
            if (!locationDropdown) return;
            const options = locationDropdown.querySelectorAll(".kg-location-option");
            options.forEach((opt, i) => {
                opt.classList.toggle("active", i === activeIndex);
            });

            if (activeIndex >= 0 && options[activeIndex]) {
                options[activeIndex].scrollIntoView({ block: "nearest" });
            }
        }

        async function searchLocations(query) {
            if (!query || query.trim().length < 2) {
                hideLocationDropdown();
                return;
            }

            try {
                const res = await fetch(`https://api.teleport.org/api/cities/?search=${encodeURIComponent(query.trim())}&limit=8`);
                const data = await res.json();

                const results = data?._embedded?.["city:search-results"] || [];
                const items = results
                    .map(x => x.matching_full_name)
                    .filter(Boolean);

                renderLocationOptions(items);
            } catch {
                hideLocationDropdown();
            }
        }

        if (locationInput && locationDropdown) {
            setCurrencyHint(locationInput.value);

            locationInput.addEventListener("input", function () {
                const val = locationInput.value || "";
                setCurrencyHint(val);

                clearTimeout(locationTimer);
                locationTimer = setTimeout(() => {
                    searchLocations(val);
                }, 220);
            });

            locationInput.addEventListener("focus", function () {
                const val = locationInput.value || "";
                if (val.trim().length >= 2) {
                    searchLocations(val);
                }
            });

            locationInput.addEventListener("keydown", function (e) {
                if (locationDropdown.classList.contains("d-none")) return;

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    activeIndex = Math.min(activeIndex + 1, currentOptions.length - 1);
                    updateActiveOption();
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    activeIndex = Math.max(activeIndex - 1, 0);
                    updateActiveOption();
                } else if (e.key === "Enter") {
                    if (activeIndex >= 0 && currentOptions[activeIndex]) {
                        e.preventDefault();
                        locationInput.value = currentOptions[activeIndex];
                        setCurrencyHint(locationInput.value);
                        hideLocationDropdown();
                    }
                } else if (e.key === "Escape") {
                    hideLocationDropdown();
                }
            });

            document.addEventListener("click", function (e) {
                if (!locationDropdown.contains(e.target) && e.target !== locationInput) {
                    hideLocationDropdown();
                }
            });

            locationInput.addEventListener("blur", function () {
                setTimeout(() => {
                    if (document.activeElement !== locationInput) {
                        hideLocationDropdown();
                    }
                }, 150);
            });
        }

        const goalInput = document.getElementById("goalAmount");

        if (goalInput) {
            function cleanAmount(value) {
                value = (value || "").replace(/[^0-9.]/g, "");

                const firstDot = value.indexOf(".");
                if (firstDot !== -1) {
                    value =
                        value.slice(0, firstDot + 1) +
                        value.slice(firstDot + 1).replace(/\./g, "");
                }

                if (value.startsWith(".")) {
                    value = "0" + value;
                }

                return value;
            }

            goalInput.addEventListener("focus", function () {
                if (goalInput.value === "0" || goalInput.value === "0.00") {
                    goalInput.value = "";
                }
            });

            goalInput.addEventListener("input", function () {
                goalInput.value = cleanAmount(goalInput.value);
            });

            goalInput.addEventListener("paste", function (e) {
                e.preventDefault();
                const pasted = (e.clipboardData || window.clipboardData).getData("text");
                goalInput.value = cleanAmount(pasted);
            });

            goalInput.addEventListener("blur", function () {
                goalInput.value = cleanAmount(goalInput.value);
            });

            goalInput.addEventListener("keydown", function (e) {
                const allowed = [
                    "Backspace", "Delete", "Tab", "Escape", "Enter",
                    "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown",
                    "Home", "End"
                ];

                if (
                    allowed.includes(e.key) ||
                    (e.ctrlKey || e.metaKey)
                ) {
                    return;
                }

                if (!/[0-9.]/.test(e.key)) {
                    e.preventDefault();
                }
            });
        }

    });
    </script>
}