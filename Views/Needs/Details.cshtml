@model UpliftBridge.Models.Need
@using UpliftBridge.Models

@{
    ViewData["Title"] = Model.Title ?? "Need Details";

    var photos = (ViewBag.Photos as IEnumerable<string>)?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList()
                 ?? new List<string>();

    var updates = (ViewBag.Updates as IEnumerable<NeedUpdate>)?.ToList()
                  ?? new List<NeedUpdate>();

    var raised = Model.AmountRaised < 0 ? 0 : Model.AmountRaised;
    var goal = Model.GoalAmount;
    var remaining = goal > 0 ? Math.Max(0, goal - raised) : 0;
    var pct = goal > 0 ? Math.Min(100, (int)Math.Round((double)(raised / goal * 100m))) : 0;
}

@section Styles {
<style>
    .hero {
        background: rgba(15,23,42,.85);
        border-radius: 26px;
        padding: 2rem;
        color: #fff;
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }

    .cardx {
        background: #fff;
        border-radius: 22px;
        padding: 1.5rem;
        box-shadow: 0 12px 35px rgba(15,23,42,.08);
        border: 1px solid rgba(15,23,42,.08);
        margin-bottom: 1rem;
    }

    .progress {
        height: 10px;
        border-radius: 999px;
        overflow: hidden;
        background: #e5e7eb;
    }

    .progress div {
        height: 100%;
        background: linear-gradient(90deg,#e6d3a2,#c8a96a);
    }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: .5rem;
    }

    .photo-grid img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 12px;
    }

    .cta {
        border-radius: 999px;
        padding: 14px;
        font-weight: 900;
        font-size: 1.05rem;
    }

    @@media(max-width:768px){
        .photo-grid{grid-template-columns:1fr 1fr;}
    }

    @@media(max-width:480px){
        .photo-grid{grid-template-columns:1fr;}
    }
</style>
}

<div class="container py-5">

    <!-- HERO -->
    <div class="hero mb-4">
        <div style="letter-spacing:.15em;font-size:.8rem;opacity:.85;">
            NEED DETAILS
        </div>

        <h1 style="font-family:'Playfair Display',serif;font-size:2.3rem;">
            @Model.Title
        </h1>

        <div style="opacity:.85;font-weight:600;">
            @Model.Category • @Model.Location
        </div>

        <a class="btn btn-light mt-3 rounded-pill fw-bold"
           asp-action="Index">
            ← Back
        </a>
    </div>

    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-7">

            <!-- FUNDING -->
            <div class="cardx">
                <div class="d-flex justify-content-between mb-2">
                    <strong>Funding</strong>
                    <span>
                        @raised.ToString("C0") • Goal @goal.ToString("C0")
                    </span>
                </div>

                <div class="progress mb-2">
                    <div style="width:@pct%"></div>
                </div>

                <small>@pct% funded • @remaining.ToString("C0") still needed</small>
            </div>

            <!-- PHOTOS -->
            @if (photos.Any())
            {
                <div class="cardx">
                    <strong>Photos</strong>
                    <div class="photo-grid mt-2">
                        @foreach (var p in photos)
                        {
                            <img src="@p" />
                        }
                    </div>
                </div>
            }

            <!-- STORY -->
            <div class="cardx">
                <strong>Story</strong>
                <p style="white-space:pre-wrap;">@Model.Description</p>
            </div>

            <!-- UPDATES -->
            @if (updates.Any())
            {
                <div class="cardx">
                    <strong>Updates</strong>
                    @foreach (var u in updates)
                    {
                        <div class="mb-3">
                            <strong>@u.Title</strong><br />
                            <small>@u.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                            <p>@u.Message</p>
                        </div>
                    }
                </div>
            }

        </div>

        <!-- RIGHT -->
        <div class="col-lg-5">

            <div class="cardx">

                <!-- 🔥 MAIN CTA -->
                <a class="btn btn-warning w-100 cta mb-3"
                   asp-controller="Needs"
                   asp-action="Fund"
                   asp-route-id="@Model.Id">
                    Give a Gift
                </a>

                <!-- TRUST -->
                <div>
                    <strong>Trust level</strong><br />
                    <span>@Model.VerificationLevel</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.VerificationNote))
                {
                    <p class="mt-2">@Model.VerificationNote</p>
                }

                <!-- INSTITUTION -->
                @if (!string.IsNullOrWhiteSpace(Model.InstitutionName))
                {
                    <hr />
                    <strong>Institution</strong><br />
                    <span>@Model.InstitutionName (@Model.InstitutionType)</span>
                }

                <!-- EXTERNAL LINK -->
                @if (!string.IsNullOrWhiteSpace(Model.InstitutionPaymentLink))
                {
                    <a class="btn btn-outline-dark w-100 mt-3 rounded-pill fw-bold"
                       href="@Model.InstitutionPaymentLink"
                       target="_blank">
                        Pay directly to institution
                    </a>
                }

            </div>

        </div>

    </div>
</div>