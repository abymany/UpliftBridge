@model UpliftBridge.Models.Need
@{
    ViewData["Title"] = "Complete your donation";

    var link = (Model.InstitutionPaymentLink ?? "").Trim();
    var hasHttps = Uri.TryCreate(link, UriKind.Absolute, out var uri) && uri.Scheme == "https";
    var allowed = Model.PreferDirectToInstitution && hasHttps;
}

<div class="kg-wrap kg-shell">
  <div class="kg-glass">
    <h1 class="kg-title">Step 2: Complete your donation</h1>

    <p class="kg-muted">
      Your UpliftBridge platform support is confirmed. Now complete the actual gift directly on the official payment site.
    </p>

    @if (allowed)
    {
      <div class="alert alert-secondary text-start">
        <strong>Official payee:</strong> @Model.InstitutionName
        @if (!string.IsNullOrWhiteSpace(Model.InstitutionType))
        {
            <span class="text-muted">(@Model.InstitutionType)</span>
        }

        <div class="small text-muted mt-2">
          UpliftBridge does not collect the gift amount for this need. You will complete the donation directly with the official payee.
        </div>
      </div>

      <div class="alert alert-info text-start">
        If the official payment page does not open automatically, use the button below.
      </div>

      <a class="kg-btn kg-btn-solid"
         href="@link"
         target="_blank"
         rel="noopener noreferrer">
        Open official payment link
      </a>

      <script>
        setTimeout(function () {
            window.open('@link', '_blank', 'noopener,noreferrer');
        }, 1200);
      </script>
    }
    else
    {
      <div class="alert alert-warning mt-3 text-start">
        This need does not have a verified HTTPS official payment link enabled yet. Please go back to the need page or contact UpliftBridge before proceeding.
      </div>
    }

    <div class="mt-3">
      <a class="kg-btn" asp-action="Details" asp-route-id="@Model.Id">Back to need</a>
    </div>
  </div>
</div>