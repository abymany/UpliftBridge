@{
    ViewData["Title"] = "Verify Email";
    var needId = (int)ViewBag.NeedId;
    var email = (string)(ViewBag.Email ?? "");
}

<div class="container py-5" style="max-width:700px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="mb-2">Verify your email</h2>
            <p class="text-muted">
                We use verification to reduce fake submissions and strengthen trust.
            </p>

            <div class="mb-4">
                <strong>Email:</strong> @email
            </div>

            @if (TempData["OtpMessage"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["OtpMessage"]
                </div>
            }

            @if (TempData["OtpError"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["OtpError"]
                </div>
            }

            @if (TempData["OtpSuccess"] != null)
            {
                <div class="alert alert-success">
                    @TempData["OtpSuccess"]
                </div>
            }

            <form asp-action="SendOtp" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@needId" />
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    Send OTP
                </button>
            </form>

            <form asp-action="ConfirmOtp" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@needId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Enter OTP</label>
                    <input type="text" name="otp" maxlength="6" class="form-control" placeholder="6-digit code" />
                </div>

                <button type="submit" class="btn btn-success rounded-pill px-4">
                    Verify Email
                </button>
            </form>
        </div>
    </div>
</div>