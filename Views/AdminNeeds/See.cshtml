  }

  .preview-sub{
    font-weight: 800;
    color: rgba(255,255,255,.78);
  }

  .preview-badges{
    display:flex;
    flex-wrap:wrap;
    gap:.5rem;
    margin-top:1rem;
  }

  .preview-badge{
    border-radius:999px;
    padding:.35rem .8rem;
    border:1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.08);
    font-size:.78rem;
    font-weight:900;
    letter-spacing:.08em;
    text-transform: uppercase;
  }

  .simple-card{
    border-radius: 20px;
    border:1px solid rgba(15,23,42,.08);
    background: rgba(255,255,255,.98);
    padding: 1.1rem 1.15rem;
    margin-bottom: 1rem;
  }

  .simple-card h3{
    font-size:1rem;
    font-weight:950;
    margin-bottom:.8rem;
    color:#0f172a;
  }

  .photo-grid{
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap: .8rem;
  }

  .photo-box{
    border-radius: 18px;
    overflow:hidden;
    background: rgba(15,23,42,.05);
    border:1px solid rgba(15,23,42,.08);
    aspect-ratio: 4 / 3;
  }

  .photo-box img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  .item-row{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    border-radius:16px;
    border:1px solid rgba(15,23,42,.08);
    background: rgba(15,23,42,.03);
    padding:.8rem .95rem;
    margin-bottom:.65rem;
    font-weight:800;
  }

  .preview-text{
    color: rgba(15,23,42,.8);
    font-weight: 700;
    line-height: 1.65;
    white-space: pre-line;
  }

  @@media (max-width: 992px){
    .admin-layout{
      grid-template-columns: 1fr;
    }
    .admin-grid-2{
      grid-template-columns: 1fr;
    }
    .photo-grid{
      grid-template-columns: 1fr;
    }
  }
</style>
}

<div class="py-4 py-lg-5">
  <div class="container admin-shell">

    <div class="admin-topbar">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
          <div class="admin-topbar-label">Admin verification review</div>
          <div class="admin-topbar-title">@(Model.Title ?? $"Need #{Model.Id}")</div>
          <div class="admin-topbar-sub">
            Review tone: <strong>@reviewTone</strong>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-dark pill-btn"
             asp-controller="AdminNeeds"
             asp-action="Index"
             asp-route-key="@adminKey">
            ← Back to Admin list
          </a>

          @if (Model.IsPublished)
          {
            <a class="btn btn-outline-dark pill-btn"
               asp-controller="Needs"
               asp-action="Details"
               asp-route-id="@Model.Id"
               target="_blank">
              Open public page
            </a>
          }
        </div>
      </div>

      <div class="status-row">
        <span class="status-badge">@Model.VerificationLevel</span>

        @if (Model.IsEmailVerified)
        {
          <span class="status-badge status-ok">Email verified</span>
        }
        else
        {
          <span class="status-badge status-warn">Email not verified</span>
        }

        @if (Model.IsPhoneVerified)
        {
          <span class="status-badge status-ok">Phone verified</span>
        }
        else
        {
          <span class="status-badge status-warn">Phone not verified</span>
        }

        @if (hasToken)
        {
          <span class="status-badge status-info">Token present</span>
        }
        else
        {
          <span class="status-badge status-warn">Token missing</span>
        }

        @if (Model.IsSuspicious || suspiciousPaymentText)
        {
          <span class="status-badge status-danger">High risk</span>
        }
        else
        {
          <span class="status-badge status-ok">No risk flag</span>
        }

        @if (isRejected)
        {
          <span class="status-badge status-danger">Rejected</span>
        }
        else if (isPending)
        {
          <span class="status-badge status-warn">Pending</span>
        }
        else if (isLive)
        {
          <span class="status-badge status-ok">Published</span>
        }

        @if (!string.IsNullOrWhiteSpace(Model.InternalReviewStatus))
        {
          <span class="status-badge">@Model.InternalReviewStatus</span>
        }
      </div>

      <div class="admin-actions">
        @if (!Model.IsPublished)
        {
          <form asp-controller="AdminNeeds" asp-action="Approve" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="@adminKey" />
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-success pill-btn">Approve & Publish</button>
          </form>

          <form asp-controller="AdminNeeds" asp-action="Reject" method="post" class="d-flex gap-2 flex-wrap align-items-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="@adminKey" />
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <input type="text"
                   name="reason"
                   required
                   class="form-control"
                   placeholder="Rejection reason (required)"
                   style="max-width:380px;" />
            <button type="submit" class="btn btn-danger pill-btn">Reject</button>
          </form>
        }

        @if (isRejected)
        {
          <div class="review-note w-100">
            <strong>Rejection reason:</strong>
            @Model.RejectionReason
          </div>
        }
      </div>
    </div>

    <div class="admin-layout">
      <div>
        <div class="admin-card">
          <div class="section-kicker">Requester identity</div>
          <div class="section-title">Private requester details</div>

          <div class="admin-grid-2">
            <div class="info-box">
              <div class="info-label">Requester name</div>
              <div class="info-value @(hasRequesterName ? "" : "muted-value")">
                @(hasRequesterName ? Model.RequesterName : "Missing")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Requester email</div>
              <div class="info-value @(hasEmail ? "" : "muted-value")">
                @(hasEmail ? Model.RequesterEmail : "Missing")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Phone number</div>
              <div class="info-value @(hasPhone ? "" : "muted-value")">
                @(hasPhone ? Model.PhoneNumber : "Missing")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Submission token</div>
              <div class="info-value @(hasToken ? "" : "muted-value")">
                @(hasToken ? Model.SubmissionToken : "Missing")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Submitted at</div>
              <div class="info-value">
                @Model.CreatedAt.ToString("yyyy-MM-dd h:mm tt 'UTC'")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Category and location</div>
              <div class="info-value">
                @Model.Category • @Model.Location
              </div>
            </div>
          </div>
        </div>

        <div class="admin-card">
          <div class="section-kicker">Institution & payment safety</div>
          <div class="section-title">Verification package</div>

          <div class="admin-grid-2">
            <div class="info-box">
              <div class="info-label">Institution name</div>
              <div class="info-value @(string.IsNullOrWhiteSpace(Model.InstitutionName) ? "muted-value" : "")">
                @(string.IsNullOrWhiteSpace(Model.InstitutionName) ? "Missing" : Model.InstitutionName)
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Institution type</div>
              <div class="info-value @(string.IsNullOrWhiteSpace(Model.InstitutionType) ? "muted-value" : "")">
                @(string.IsNullOrWhiteSpace(Model.InstitutionType) ? "Missing" : Model.InstitutionType)
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Private institution address</div>
              <div class="info-value @(hasPrivateAddress ? "" : "muted-value")">
                @(hasPrivateAddress ? Model.InstitutionFullAddress : "Missing")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Institution payment link</div>
              <div class="info-value @(hasOfficialLink ? "" : "muted-value")">
                @if (hasOfficialLink)
                {
                  <a href="@Model.InstitutionPaymentLink" target="_blank" rel="noopener noreferrer">
                    @Model.InstitutionPaymentLink
                  </a>
                }
                else
                {
                  <span>Missing</span>
                }
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Pay to</div>
              <div class="info-value @(string.IsNullOrWhiteSpace(Model.PayTo) ? "muted-value" : "")">
                @(string.IsNullOrWhiteSpace(Model.PayTo) ? "Missing" : Model.PayTo)
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Direct to institution preferred</div>
              <div class="info-value">
                @(Model.PreferDirectToInstitution ? "Yes" : "No")
              </div>
            </div>
          </div>

          <div class="status-row mt-3">
            @if (hasInstitution)
            {
              <span class="status-badge status-ok">Institution details present</span>
            }
            else
            {
              <span class="status-badge status-warn">Institution details missing</span>
            }

            @if (hasOfficialLink)
            {
              <span class="status-badge @(officialLinkLooksOkay ? "status-ok" : "status-warn")">
                @(officialLinkLooksOkay ? "Official-looking link" : "Link needs review")
              </span>
            }
            else
            {
              <span class="status-badge status-warn">No payment link</span>
            }

            @if (suspiciousPaymentText)
            {
              <span class="status-badge status-danger">Personal payment handle detected</span>
            }
          </div>
        </div>

        <div class="admin-card">
          <div class="section-kicker">Verification controls</div>
          <div class="section-title">Review and moderation</div>

          <form method="post" asp-controller="AdminNeeds" asp-action="UpdateVerification" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="key" value="@adminKey" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="emailVerified" value="true" @(Model.IsEmailVerified ? "checked" : "") />
                  <label class="form-check-label">Email verified</label>
                </div>
                <input type="hidden" name="emailVerified" value="false" />
              </div>

              <div class="col-md-6">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="phoneVerified" value="true" @(Model.IsPhoneVerified ? "checked" : "") />
                  <label class="form-check-label">Phone verified</label>
                </div>
                <input type="hidden" name="phoneVerified" value="false" />
              </div>

              <div class="col-md-6">
                <label class="form-label">Internal review status</label>
                <select class="form-select" name="status">
                  <option value="Pending" selected="@(Model.InternalReviewStatus == "Pending")">Pending</option>
                  <option value="Needs More Info" selected="@(Model.InternalReviewStatus == "Needs More Info")">Needs More Info</option>
                  <option value="Flagged" selected="@(Model.InternalReviewStatus == "Flagged")">Flagged</option>
                  <option value="Approved" selected="@(Model.InternalReviewStatus == "Approved")">Approved</option>
                  <option value="Rejected" selected="@(Model.InternalReviewStatus == "Rejected")">Rejected</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label">Verification level</label>
                <form asp-controller="AdminNeeds" asp-action="SetVerificationLevel" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@Model.Id" />
                  <input type="hidden" name="key" value="@adminKey" />
                  <input type="hidden" name="returnUrl" value="@returnUrl" />
                  <select class="form-select mb-2" name="verificationLevel">
                    <option value="BasicContactVerified" selected="@(Model.VerificationLevel == VerificationLevel.BasicContactVerified)">BasicContactVerified</option>
                    <option value="CommunityVerified" selected="@(Model.VerificationLevel == VerificationLevel.CommunityVerified)">CommunityVerified</option>
                    <option value="OrganizationVerified" selected="@(Model.VerificationLevel == VerificationLevel.OrganizationVerified)">OrganizationVerified</option>
                  </select>
                  <input type="text" class="form-control mb-2" name="note" placeholder="Optional verification note" value="@Model.VerificationNote" />
                  <button type="submit" class="btn btn-outline-dark pill-btn">Save verification level</button>
                </form>
              </div>

              <div class="col-12">
                <label class="form-label">Risk notes</label>
                <textarea class="form-control" name="riskNotes">@Model.RiskNotes</textarea>
              </div>

              <div class="col-12">
                <label class="form-label">Internal review notes</label>
                <textarea class="form-control" name="internalNotes">@Model.InternalReviewNotes</textarea>
              </div>
            </div>

            <div class="mini-actions">
              <button type="submit" class="btn btn-dark pill-btn">Save review state</button>
            </div>
          </form>

          <div class="mini-actions">
            <form asp-controller="AdminNeeds" asp-action="MarkNeedsInfo" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@Model.Id" />
              <input type="hidden" name="key" value="@adminKey" />
              <input type="hidden" name="returnUrl" value="@returnUrl" />
              <input type="hidden" name="notes" value="Need more information before approval." />
              <button type="submit" class="btn btn-outline-dark pill-btn">Mark Needs More Info</button>
            </form>

            <form asp-controller="AdminNeeds" asp-action="FlagSuspicious" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@Model.Id" />
              <input type="hidden" name="key" value="@adminKey" />
              <input type="hidden" name="returnUrl" value="@returnUrl" />
              <input type="hidden" name="notes" value="Flagged for manual fraud/risk review." />
              <button type="submit" class="btn btn-outline-danger pill-btn">Flag suspicious</button>
            </form>
          </div>
        </div>
      </div>

      <div>
        <div class="admin-card">
          <div class="section-kicker">Audit trail</div>
          <div class="section-title">Recorded admin history</div>

          <div class="admin-grid-2">
            <div class="info-box">
              <div class="info-label">Reviewed by</div>
              <div class="info-value @(string.IsNullOrWhiteSpace(Model.ReviewedBy) ? "muted-value" : "")">
                @(string.IsNullOrWhiteSpace(Model.ReviewedBy) ? "Not recorded" : Model.ReviewedBy)
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Reviewed at</div>
              <div class="info-value @(Model.ReviewedAtUtc.HasValue ? "" : "muted-value")">
                @(Model.ReviewedAtUtc.HasValue ? Model.ReviewedAtUtc.Value.ToString("yyyy-MM-dd h:mm tt 'UTC'") : "Not recorded")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Verified by</div>
              <div class="info-value @(string.IsNullOrWhiteSpace(Model.VerifiedBy) ? "muted-value" : "")">
                @(string.IsNullOrWhiteSpace(Model.VerifiedBy) ? "Not recorded" : Model.VerifiedBy)
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Verified at</div>
              <div class="info-value @(Model.VerifiedAtUtc.HasValue ? "" : "muted-value")">
                @(Model.VerifiedAtUtc.HasValue ? Model.VerifiedAtUtc.Value.ToString("yyyy-MM-dd h:mm tt 'UTC'") : "Not recorded")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Email verified at</div>
              <div class="info-value @(Model.EmailVerifiedAtUtc.HasValue ? "" : "muted-value")">
                @(Model.EmailVerifiedAtUtc.HasValue ? Model.EmailVerifiedAtUtc.Value.ToString("yyyy-MM-dd h:mm tt 'UTC'") : "Not verified")
              </div>
            </div>

            <div class="info-box">
              <div class="info-label">Verification note</div>
              <div class="info-value @(hasVerificationNote ? "" : "muted-value")">
                @(hasVerificationNote ? Model.VerificationNote : "None")
              </div>
            </div>
          </div>
        </div>

        <div class="admin-card">
          <div class="section-kicker">Risk signals</div>
          <div class="section-title">What stands out</div>

          <div class="review-note">
            <div><strong>Risk notes:</strong> @(string.IsNullOrWhiteSpace(Model.RiskNotes) ? "None" : Model.RiskNotes)</div>
            <div class="mt-2"><strong>Internal review notes:</strong> @(string.IsNullOrWhiteSpace(Model.InternalReviewNotes) ? "None" : Model.InternalReviewNotes)</div>
          </div>

          <div class="status-row mt-3">
            <span class="status-badge @(Model.IsSuspicious ? "status-danger" : "status-ok")">
              @(Model.IsSuspicious ? "Marked suspicious" : "Not marked suspicious")
            </span>

            <span class="status-badge @(looksLikePersonalHandle(Model.PayTo) ? "status-danger" : "status-ok")">
              @(looksLikePersonalHandle(Model.PayTo) ? "Pay-to field needs review" : "Pay-to field looks cleaner")
            </span>

            <span class="status-badge @(hasPrivateAddress ? "status-ok" : "status-warn")">
              @(hasPrivateAddress ? "Private address present" : "Private address missing")
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="preview-card">
      <div class="section-kicker">Public-style preview</div>
      <div class="section-title">What a donor-facing version roughly looks like</div>

      <div class="preview-hero">
        <div class="section-kicker" style="color:rgba(255,255,255,.7);margin-bottom:.35rem;">Need preview</div>
        <h1>@(Model.Title ?? $"Need #{Model.Id}")</h1>
        <div class="preview-sub">@Model.Category • @Model.Location</div>

        <div class="preview-badges">
          <div class="preview-badge">@Model.VerificationLevel</div>
          <div class="preview-badge">@pct% funded</div>
          <div class="preview-badge">Created @Model.CreatedAt.ToString("MMM d, yyyy")</div>
          <div class="preview-badge">@(isPending ? "Pending" : isRejected ? "Rejected" : "Live")</div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-8">
          <div class="simple-card">
            <h3>Story</h3>
            <div class="preview-text">@(string.IsNullOrWhiteSpace(story) ? Model.Description : story)</div>
          </div>

          <div class="simple-card">
            <h3>Details</h3>

            @if (!string.IsNullOrWhiteSpace(dream))
            {
              <div class="mb-3">
                <div class="fw-bold mb-1">Long-term dream</div>
                <div class="preview-text">@dream</div>
              </div>
            }

            @if (!string.IsNullOrWhiteSpace(tried))
            {
              <div class="mb-3">
                <div class="fw-bold mb-1">What has already been tried</div>
                <div class="preview-text">@tried</div>
              </div>
            }

            @if (!string.IsNullOrWhiteSpace(timing))
            {
              <div>
                <div class="fw-bold mb-1">Timing</div>
                <div class="preview-text">@timing</div>
              </div>
            }
          </div>

          <div class="simple-card">
            <h3>Requested items</h3>

            @if (parsedItems.Any())
            {
              @foreach (var item in parsedItems)
              {
                <div class="item-row">
                  <div>
                    <div>@item.Name</div>
                    @if (!string.IsNullOrWhiteSpace(item.Link))
                    {
                      <div class="mt-1">
                        <a href="@item.Link" target="_blank" rel="noopener noreferrer">Open item link</a>
                      </div>
                    }
                  </div>
                  <div>@item.Cost</div>
                </div>
              }
            }
            else
            {
              <div class="preview-text">No structured items found.</div>
            }
          </div>
        </div>

        <div class="col-lg-4">
          <div class="simple-card">
            <h3>Funding</h3>
            <div class="preview-text">
              ¤@raised raised • Goal ¤@goal • Still needed ¤@remaining
            </div>
          </div>

          <div class="simple-card">
            <h3>Photos</h3>

            @if (photos.Any())
            {
              <div class="photo-grid">
                @foreach (var photo in photos)
                {
                  <div class="photo-box">
                    <img src="@photo" alt="Need photo" />
                  </div>
                }
              </div>
            }
            else
            {
              <div class="preview-text">No photos uploaded.</div>
            }
          </div>
        </div>
      </div>
    </div>

  </div>
</div>