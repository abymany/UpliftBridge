    color: rgba(15,23,42,.78);
  }

  .admin-form label{
    font-weight: 850;
    color: #111827;
    margin-bottom: .4rem;
  }

  .admin-form textarea,
  .admin-form select,
  .admin-form input[type="text"]{
    border-radius: 16px;
  }

  .admin-form textarea{
    min-height: 110px;
  }

  .mini-actions{
    display:flex;
    flex-wrap:wrap;
    gap:.7rem;
    margin-top:1rem;
  }

  .preview-hero{
    border-radius: 24px;
    background: rgba(15,23,42,.78);
    color: rgba(255,255,255,.94);
