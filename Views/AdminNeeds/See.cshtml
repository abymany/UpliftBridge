  .info-label{
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(15,23,42,.52);
    margin-bottom: .3rem;
  }

  .info-value{
    font-size: .98rem;
    font-weight: 800;
    color: #0f172a;
