@model UpliftBridge.Models.Need
@using UpliftBridge.Models
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = (Model.Title ?? "Need") + " — Admin Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "needs-details-page";

    var updates = ViewBag.Updates as List<NeedUpdate> ?? new List<NeedUpdate>();
    var photos = ViewBag.Photos as List<string> ?? new List<string>();
    var adminKey = (ViewBag.AdminKey as string) ?? "";

    string Safe(string? s) => (s ?? "").Trim();

    var returnUrl = (Context?.Request?.Path.ToString() ?? "") + (Context?.Request?.QueryString.ToString() ?? "");

    var raw = Safe(Model.Description);

    var blocks = raw.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries)
                    .Select(b => b.Trim())
                    .ToList();

    var sections = new List<(string Title, string Body)>();

    foreach (var b in blocks)
    {
        var lines = b.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None).ToList();
        if (lines.Count >= 3 && Regex.IsMatch(lines[1], @"^\-+$|^\—+$|^_+$"))
        {
            var title = lines[0].Trim();
            var body = string.Join("\n", lines.Skip(2)).Trim();
            sections.Add((title, body));
        }
        else
        {
            sections.Add(("", b));
        }
    }

    string? GetSection(string name)
        => sections.FirstOrDefault(s => s.Title.Equals(name, StringComparison.OrdinalIgnoreCase)).Body;

    var story = GetSection("Story");
    var dream = GetSection("Long-term dream");
    var tried = GetSection("What has already been tried");
    var timing = GetSection("Timing");
    var reqItems = GetSection("Requested items");

    var parsedItems = new List<(string Name, string Cost, string Link)>();
    if (!string.IsNullOrWhiteSpace(reqItems))
    {
        var lines = reqItems.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
                            .Select(x => x.Trim())
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .ToList();

        string curName = "", curCost = "", curLink = "";

        foreach (var line in lines)
        {
            var m = Regex.Match(line, @"^\d+\.\s+(.*?)(?:\s+—\s+(.*))?$");
            if (m.Success)
            {
                if (!string.IsNullOrWhiteSpace(curName))
                    parsedItems.Add((curName, curCost, curLink));

                curName = m.Groups[1].Value.Trim();
                curCost = m.Groups[2].Value.Trim();
                curLink = "";
                continue;
            }

            var m2 = Regex.Match(line, @"^Link:\s*(.*)$", RegexOptions.IgnoreCase);
            if (m2.Success)
            {
                curLink = m2.Groups[1].Value.Trim();
                continue;
            }
        }

        if (!string.IsNullOrWhiteSpace(curName))
            parsedItems.Add((curName, curCost, curLink));
    }

    var goal = Model.GoalAmount;
    var raised = Model.AmountRaised < 0 ? 0 : Model.AmountRaised;
    var remaining = goal > 0 ? Math.Max(0m, goal - raised) : 0m;
    var pct = (goal > 0) ? Math.Min(100, (int)Math.Round((double)(raised / goal * 100m))) : 0;

    var isPending = !Model.IsPublished && string.IsNullOrWhiteSpace(Model.RejectionReason);
    var isRejected = !Model.IsPublished && !string.IsNullOrWhiteSpace(Model.RejectionReason);
    var isLive = Model.IsPublished;

    var hasInstitution = !string.IsNullOrWhiteSpace(Model.InstitutionName) || !string.IsNullOrWhiteSpace(Model.InstitutionType);
    var hasOfficialLink = !string.IsNullOrWhiteSpace(Model.InstitutionPaymentLink);
    var hasPrivateAddress = !string.IsNullOrWhiteSpace(Model.InstitutionFullAddress);
    var hasEmail = !string.IsNullOrWhiteSpace(Model.RequesterEmail);
    var hasPhone = !string.IsNullOrWhiteSpace(Model.PhoneNumber);
    var hasRequesterName = !string.IsNullOrWhiteSpace(Model.RequesterName);
    var hasVerificationNote = !string.IsNullOrWhiteSpace(Model.VerificationNote);
    var hasToken = !string.IsNullOrWhiteSpace(Model.SubmissionToken);

    bool looksLikePersonalHandle(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        var t = text.ToLowerInvariant();
        return t.Contains("cashapp") || t.Contains("venmo") || t.Contains("paypal.me") || t.Contains("$");
    }

    var suspiciousPaymentText =
        looksLikePersonalHandle(Model.Description) ||
        looksLikePersonalHandle(Model.PayTo) ||
        looksLikePersonalHandle(Model.InstitutionPaymentLink);

    var officialLinkLooksOkay =
        !string.IsNullOrWhiteSpace(Model.InstitutionPaymentLink) &&
        (Model.InstitutionPaymentLink.Contains(".edu", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains(".org", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains("school", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains("college", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains("university", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains("hospital", StringComparison.OrdinalIgnoreCase) ||
         Model.InstitutionPaymentLink.Contains("clinic", StringComparison.OrdinalIgnoreCase));

    string reviewTone;
    if (Model.IsSuspicious || suspiciousPaymentText)
        reviewTone = "High caution";
    else if (hasInstitution && hasOfficialLink && hasPrivateAddress && hasEmail && hasRequesterName)
        reviewTone = "Stronger verification package";
    else
        reviewTone = "Needs more verification";
}

