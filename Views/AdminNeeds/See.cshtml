  }

  .muted-value{
    color: rgba(15,23,42,.56);
  }

  .status-row{
    display:flex;
    flex-wrap:wrap;
    gap:.55rem;
    margin-top:.4rem;
  }

  .status-badge{
    border-radius:999px;
    padding:.42rem .85rem;
    font-size:.78rem;
    font-weight:900;
    letter-spacing:.04em;
    border:1px solid rgba(15,23,42,.12);
    background: rgba(15,23,42,.05);
    color:#0f172a;
  }

  .status-ok{
    background: rgba(34,197,94,.12);
    border-color: rgba(34,197,94,.24);
  }

  .status-warn{
    background: rgba(245,158,11,.12);
    border-color: rgba(245,158,11,.28);
  }

  .status-danger{
