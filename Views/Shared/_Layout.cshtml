<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UpliftBridge</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        .kg-navbar {}

        .kg-navbar .kg-brand-fixed{
            display:inline-flex!important;
            align-items:center!important;
            gap:8px!important;
            text-decoration:none!important;
            font-size:1.45rem!important;
            font-weight:800!important;
            white-space:nowrap!important;
        }

        .kg-navbar .kg-brand-logo{
            height:58px!important;
        }

        .kg-navbar .kg-brand-name{
            color:#E6C37A!important;
        }

        .kg-navbar .navbar-nav .nav-link{
            font-weight:600;
            opacity:.92;
        }

        .kg-navbar .kg-cta{
            display:inline-flex!important;
            align-items:center!important;
            justify-content:center!important;
            height:44px!important;
            padding:0 18px!important;
            border-radius:999px!important;
            background:#E6C37A!important;
            color:#1a1a1a!important;
            font-weight:800!important;
            text-decoration:none!important;
        }

        .kg-footer{
            background:#111822;
            color:#d8dbe2;
            margin-top:80px;
            padding:50px 0;
        }

        .kg-footer a{
            color:#E6C37A;
            text-decoration:none;
            margin-right:20px;
        }

        .kg-footer a:hover{
            text-decoration:underline;
        }

        .kg-footer-note{
            margin-top:18px;
            color:#aeb6c2;
            font-size:.92rem;
            line-height:1.7;
        }

        .kg-footer-copy{
            margin-top:18px;
            font-size:.85rem;
            opacity:.7;
        }
    </style>
</head>

<body>

<header>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark kg-navbar">
<div class="container">

<a class="navbar-brand kg-brand-fixed"
asp-controller="Home"
asp-action="Index">

<img class="kg-brand-logo"
src="~/images/ub-logo.png"
alt="UpliftBridge"/>

<span class="kg-brand-name">
UpliftBridge
</span>

</a>

<button class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#navbarContent">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse"
id="navbarContent">

<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="Index">Home</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Needs"
asp-action="Index">Needs</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Needs"
asp-action="Create">Post a Need</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="Stories">Success Stories</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="Verify">
How Verification Works
</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="About">
Why UpliftBridge
</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="Faq">
FAQ
</a>
</li>

<li class="nav-item">
<a class="nav-link"
asp-controller="Home"
asp-action="Schools">
For Schools & Coaches
</a>
</li>

</ul>

<a class="kg-cta"
asp-controller="Needs"
asp-action="Index">
Give a Gift
</a>

</div>

</div>
</nav>
</header>

<div class="container">
<main role="main" class="pb-3">
@RenderBody()
</main>
</div>

<footer class="kg-footer">

<div class="container">

<div>

<a asp-controller="Home" asp-action="Terms">
Terms
</a>

<a asp-controller="Home" asp-action="Privacy">
Privacy
</a>

<a asp-controller="Home" asp-action="Safety">
Safety
</a>

<a asp-controller="Home" asp-action="Contact">
Contact
</a>

</div>

<div class="kg-footer-note">

UpliftBridge facilitates discovery and verification of needs.

Donations for listed needs are completed directly with external organizations, institutions, schools, teams, vendors or official payees where applicable.

UpliftBridge does not collect or hold need donations.

</div>

<div class="kg-footer-copy">

© @DateTime.Now.Year UpliftBridge

</div>

</div>

</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script defer
src="~/js/bookOfKindness.js?v=@DateTime.UtcNow.Ticks">
</script>

@await RenderSectionAsync("Scripts", required:false)

</body>
</html>